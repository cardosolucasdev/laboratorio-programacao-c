#include <stdio.h>

int main()
{
    int numeros[3][3] = {
    {1,2,3},
    {4,5,6},
    {7,8,9}
    };
    
    int maior = numeros[0][0];
    
    for (int i = 0; i < 3; i++){
        for (int j = 0; j < 3; j++){
            if(numeros[i][j] > maior){
                maior = numeros[i][j];
            }
        }
    }
    
    printf("O maior valor da matriz é: %d", maior);

    return 0;
}
